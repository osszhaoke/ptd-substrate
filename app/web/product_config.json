  "onepagers": {
    "rules": {
      "why": "关注卡用了哪一版规则、规则出自哪里、有没有经过专家核实，本人和医生都应该能查到。",
      "principles": [
        "每张卡都写明规则包版本和出处",
        "专家核实状态如实显示，未核实就写未核实",
        "规则变了，旧结果保留，可以对比"
      ],
      "relation": "规则包由星轨使用；核实结论写进证据图谱；对外引用时随授权一起出域。",
      "facts": "card_state"
    },
    "space": {
      "why": "把状态卡和社区节点、研究项目连起来，在我同意的范围内参与协作。",
      "principles": [
        "参与与退出都由我决定",
        "每次出域都经过星簇授权并留痕",
        "协作方看到的内容，和授权规则里的预览一致"
      ],
      "relation": "星簇协作建立在授权规则、授权对象和授权记录之上。"
    }
